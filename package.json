{
  "name": "magical-mirai-2026-procon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:app": "npm run typecheck && vite build --mode app",
    "preview": "vite preview",
    "test": "vitest run",
    "build:font-subset": "node scripts/build-font-subset.mjs",
    "typography:fps": "node scripts/typography-fps.mjs",
    "reflection:fps": "node scripts/reflection-fps.mjs",
    "smoke": "node scripts/screens-smoke.mjs",
    "smoke:glow": "node scripts/rendering-glow-smoke.mjs",
    "smoke:input": "node scripts/input-smoke.mjs",
    "smoke:credits": "node scripts/credits-smoke.mjs",
    "smoke:typography": "node scripts/typography-deform-smoke.mjs",
    "quality": "node scripts/quality-harness.mjs --mode=local",
    "quality:cloud": "node scripts/quality-harness.mjs --mode=cloud"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.4",
    "textalive-app-api": "^0.4.0",
    "three": "^0.184.0",
    "troika-three-text": "0.52.4",
    "troika-three-utils": "0.52.4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/three": "^0.184.0",
    "ajv": "^8.17.1",
    "fontkit": "^2.0.4",
    "playwright": "^1.60.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
